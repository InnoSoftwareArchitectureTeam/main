@startuml InPlan_Academic_Progress
title InPlan — View academic progress
hide footbox
skinparam shadowing false
skinparam defaultFontName SansSerif

actor "Student (via UI)" as User
participant "student : Student" as Student
participant "service : ProgressService" as Service
participant "spec : Specialization" as Spec
participant "enrollment : Enrollment" as Enrollment
participant "mark : Mark" as Mark

note over Student, Mark
  Example: an authenticated student has one passed course
  that belongs to the selected specialization.
end note

User -> Student : 1. viewProgress(spec)
Student -> Service : 2. calculate(student, spec)
activate Service
Service -> Spec : 3. accepts(enrollment.course)
Spec --> Service : true
Service -> Enrollment : 4. earnedCredits(passThreshold)
activate Enrollment
Enrollment -> Mark : 5. isPassing(passThreshold)
Mark --> Enrollment : true
Enrollment --> Service : earnedCredits
deactivate Enrollment
Service -> Spec : 6. missingCoreCourses({enrollment.course})
Spec --> Service : missingCoreCourses

create participant "progress : AcademicProgress" as Progress
Service -> Progress : <<create>>
Service --> Student : progress
deactivate Service
Student --> User : progress

User -> Progress : 7. remainingCredits()
Progress --> User : remaining credits
User -> Progress : 8. completionPercentage()
Progress --> User : completion percentage
User -> Progress : 9. isComplete(true)
Progress --> User : completion status
@enduml
